{
  "name": "shechen-site",
  "version": "0.1.0",
  "private": true,
  "description": "雪謙（台灣）官方網站",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "pnpm build && wrangler dev",
    "check": "astro check && tsc --noEmit -p tsconfig.worker.json",
    "cms": "decap-server",
    "deploy": "pnpm build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261124.1",
    "decap-server": "^3.11.6",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.167.0"
  }
}
